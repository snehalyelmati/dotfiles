#!/bin/sh

workspace=$(aerospace list-workspaces --focused)
windows=$(aerospace list-windows --all --format '%{window-id}|%{workspace}|%{app-name}' | awk -F '|' '$3 == "Stickies"')
visible=$(osascript -e 'tell application "System Events" to get visible of process "Stickies"' 2>/dev/null)

if [ "$visible" = true ] && printf '%s\n' "$windows" | awk -F '|' -v workspace="$workspace" '$2 == workspace { found = 1 } END { exit !found }'; then
    osascript -e 'tell application "System Events" to set visible of process "Stickies" to false'
    exit
fi

osascript -e 'tell application "System Events" to set visible of process "Stickies" to true' 2>/dev/null

attempts=0
while aerospace list-windows --all --format '%{window-layout}|%{app-name}' |
    awk -F '|' '$2 == "Stickies" && $1 != "floating" { found = 1 } END { exit !found }'; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 20 ] || exit 1
    sleep 0.05
done

windows=$(aerospace list-windows --all --format '%{window-id}|%{app-name}' | awk -F '|' '$2 == "Stickies" { print $1 }')
printf '%s\n' "$windows" | while read -r window_id; do
    [ -n "$window_id" ] && aerospace move-node-to-workspace --window-id "$window_id" "$workspace"
done

osascript -e 'tell application "Stickies" to activate'
