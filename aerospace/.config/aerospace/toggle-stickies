#!/bin/sh

workspace=$(aerospace list-workspaces --focused)
windows=$(aerospace list-windows --all --format '%{window-id}|%{workspace}|%{window-layout}|%{app-name}' | awk -F '|' '$4 == "Stickies"')

if [ -z "$windows" ]; then
    open -a Stickies
    exit
fi

if printf '%s\n' "$windows" | awk -F '|' -v workspace="$workspace" '$2 == workspace && $3 != "macos_native_window_of_hidden_app" { found = 1 } END { exit !found }'; then
    osascript -e 'tell application "System Events" to set visible of process "Stickies" to false'
    exit
fi

osascript -e 'tell application "System Events" to set visible of process "Stickies" to true' 2>/dev/null

attempts=0
while aerospace list-windows --all --format '%{window-layout}|%{app-name}' |
    awk -F '|' '$2 == "Stickies" && $1 != "floating" { found = 1 } END { exit !found }'; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 20 ] || exit 1
    sleep 0.05
done

printf '%s\n' "$windows" | while IFS='|' read -r window_id window_workspace _; do
    [ "$window_workspace" = "$workspace" ] || aerospace move-node-to-workspace --window-id "$window_id" "$workspace"
done

aerospace focus --window-id "$(printf '%s\n' "$windows" | awk -F '|' 'NR == 1 { print $1 }')"
