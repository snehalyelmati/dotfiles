#!/bin/sh

workspace=$(aerospace list-workspaces --focused)
windows=$(aerospace list-windows --all --format '%{window-id}|%{workspace}|%{app-name}' | awk -F '|' '$3 == "Stickies"')
visible=$(osascript -e 'tell application "System Events" to get visible of process "Stickies"' 2>/dev/null)

if [ "$visible" = true ] && printf '%s\n' "$windows" | awk -F '|' -v workspace="$workspace" '$2 == workspace { found = 1 } END { exit !found }'; then
    osascript -e 'tell application "System Events" to set visible of process "Stickies" to false'
    exit
fi

printf '%s\n' "$windows" | awk -F '|' 'NF { print $1 }' | while read -r window_id; do
    aerospace move-node-to-workspace --window-id "$window_id" "$workspace"
done

osascript -e 'tell application "Stickies" to activate'
